<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!-- Required by ict4h atomfeed-client to track feed position -->
    <changeSet id="atomfeed-001" author="bluad">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="event_records_offset_marker" schemaName="clinlims"/></not>
        </preConditions>
        <createTable tableName="event_records_offset_marker" schemaName="clinlims">
            <column name="id" type="SERIAL"><constraints primaryKey="true"/></column>
            <column name="feed_uri" type="VARCHAR(255)"/>
            <column name="feed_uri_for_last_read_entry" type="VARCHAR(255)"/>
            <column name="last_read_entry_id" type="VARCHAR(255)"/>
            <column name="category" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>

    <!-- Required by ict4h atomfeed-client to queue events for processing -->
    <changeSet id="atomfeed-002" author="bluad">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="event_records_queue" schemaName="clinlims"/></not>
        </preConditions>
        <createTable tableName="event_records_queue" schemaName="clinlims">
            <column name="id" type="SERIAL"><constraints primaryKey="true"/></column>
            <column name="uuid" type="VARCHAR(40)"/>
            <column name="title" type="VARCHAR(255)"/>
            <column name="feed_uri" type="VARCHAR(255)"/>
            <column name="entry_uri" type="VARCHAR(255)"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="NOW()"/>
        </createTable>
    </changeSet>

    <!-- Required by ict4h atomfeed-client to track failed events for retry -->
    <changeSet id="atomfeed-003" author="bluad">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="failed_events" schemaName="clinlims"/></not>
        </preConditions>
        <createTable tableName="failed_events" schemaName="clinlims">
            <column name="id" type="SERIAL"><constraints primaryKey="true"/></column>
            <column name="feed_uri" type="VARCHAR(255)"/>
            <column name="failed_at" type="BIGINT"/>
            <column name="error_message" type="TEXT"/>
            <column name="event_id" type="VARCHAR(255)"/>
            <column name="event_content" type="TEXT"/>
            <column name="title" type="VARCHAR(255)"/>
            <column name="retries" type="INT" defaultValue="0"/>
            <column name="tags" type="VARCHAR(255)"/>
            <column name="category" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>

    <!-- Your mapping table: links OpenMRS order UUID to OE2 accession number -->
    <changeSet id="atomfeed-004" author="bluad">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="openmrs_order_mapping" schemaName="clinlims"/></not>
        </preConditions>
        <createTable tableName="openmrs_order_mapping" schemaName="clinlims">
            <column name="id" type="SERIAL"><constraints primaryKey="true"/></column>
            <column name="openmrs_encounter_uuid" type="VARCHAR(38)"><constraints nullable="false"/></column>
            <column name="openmrs_order_uuid" type="VARCHAR(38)"><constraints nullable="false"/></column>
            <column name="oe2_accession_number" type="VARCHAR(50)"/>
            <column name="oe2_patient_id" type="VARCHAR(20)"/>
            <column name="status" type="VARCHAR(20)" defaultValue="PENDING"/>
            <column name="error_message" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="NOW()"/>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="NOW()"/>
        </createTable>
    </changeSet>

    <!-- Index for fast lookup by encounter UUID -->
    <changeSet id="atomfeed-005" author="bluad">
        <preConditions onFail="MARK_RAN">
            <not><indexExists indexName="idx_openmrs_order_mapping_encounter" schemaName="clinlims"/></not>
        </preConditions>
        <createIndex indexName="idx_openmrs_order_mapping_encounter"
                     tableName="openmrs_order_mapping"
                     schemaName="clinlims">
            <column name="openmrs_encounter_uuid"/>
        </createIndex>
    </changeSet>

    <!-- Unique constraint for OpenMRS order UUID deduplication -->
    <changeSet id="atomfeed-006" author="bluad">
        <preConditions onFail="MARK_RAN">
            <not><indexExists indexName="idx_openmrs_order_mapping_order_uuid" schemaName="clinlims"/></not>
        </preConditions>
        <addUniqueConstraint
            tableName="openmrs_order_mapping"
            schemaName="clinlims"
            columnNames="openmrs_order_uuid"
            constraintName="uq_openmrs_order_mapping_order_uuid"/>
    </changeSet>

</databaseChangeLog>